---
import { rotationItems } from "@/data/rotation";
const selection = [
  rotationItems[1],
  rotationItems[2],
  rotationItems[0],
  rotationItems[7],
  ...rotationItems.filter((item) => item.featured && item !== rotationItems[2]),
].slice(0, 5);
---
<section class="panel carousel-panel stagger-item" aria-label="The rotation" aria-roledescription="carousel">
  <div class="panel-label">
    <a href="/clothing">THE ROTATION ↗</a>
    <div class="carousel-controls">
      <span class="carousel-key-hint" aria-hidden="true"><kbd>L</kbd><span>← browse →</span><kbd>R</kbd></span>
      <div class="carousel-arrows"><button type="button" data-step="-1" aria-label="Previous item (L key)">‹</button><button type="button" data-step="1" aria-label="Next item (R key)">›</button></div>
    </div>
  </div>
  <div class="carousel-track" tabindex="0" aria-label="Clothes and fragrances. Swipe to browse.">
    {selection.map((item) => <a class="carousel-slide" href="/clothing" aria-label={`${item.brand} ${item.name}, view archive`}>
      <img src={item.image} alt={`${item.brand} ${item.name}`} width="420" height="420" loading="lazy" />
      <span class="carousel-caption"><small>{item.brand}</small><strong>{item.name}</strong></span>
    </a>)}
  </div>
  <div class="carousel-bottom"><a href="/clothing">View all {rotationItems.length} items ↗</a><div class="carousel-dots" aria-label="Choose item">{selection.map((item, index) => <button type="button" data-slide={index} aria-label={`Show ${item.brand} ${item.name}`} aria-pressed={index === 0 ? "true" : "false"}><span></span></button>)}</div></div>
</section>
<script>
  const carousel = document.querySelector<HTMLElement>(".carousel-panel");
  const track = carousel?.querySelector<HTMLElement>(".carousel-track");
  const dots = Array.from(carousel?.querySelectorAll<HTMLButtonElement>("[data-slide]") ?? []);
  const slides = Array.from(track?.querySelectorAll<HTMLElement>(".carousel-slide") ?? []);
  let current = 0;

  const normalizeIndex = (index: number) => (index + dots.length) % dots.length;
  const updateDots = () => {
    dots.forEach((dot, index) => dot.setAttribute("aria-pressed", index === current ? "true" : "false"));
  };

  if (track && slides.length > 1) {
    const firstClone = slides[0].cloneNode(true) as HTMLElement;
    const lastClone = slides[slides.length - 1].cloneNode(true) as HTMLElement;

    for (const clone of [firstClone, lastClone]) {
      clone.dataset.clone = "true";
      clone.setAttribute("aria-hidden", "true");
      clone.tabIndex = -1;
    }
    track.prepend(lastClone);
    track.append(firstClone);
    track.scrollTo({ left: track.clientWidth, behavior: "auto" });
  }

  const scrollToPhysicalSlide = (index: number) => {
    if (!track) return;
    const behavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
    track.scrollTo({ left: index * track.clientWidth, behavior });
  };

  /**
   * Scrolls directly to an item selected by its dot.
   * @param {number} index - Requested item index.
   * @returns {void}
   */
  const showSlide = (index: number) => {
    if (!track || !dots.length) return;
    current = normalizeIndex(index);
    updateDots();
    scrollToPhysicalSlide(current + 1);
  };

  /**
   * Moves one physical slide so wrapping keeps the direction of travel.
   * @param {number} step - Either -1 or 1.
   * @returns {void}
   */
  const moveBy = (step: number) => {
    if (!track || !dots.length) return;
    const physicalTarget = current + 1 + step;
    current = normalizeIndex(current + step);
    updateDots();
    scrollToPhysicalSlide(physicalTarget);
  };

  const settleLoop = () => {
    if (!track || !dots.length) return;
    const physicalIndex = Math.round(track.scrollLeft / track.clientWidth);
    current = normalizeIndex(physicalIndex - 1);
    updateDots();

    if (physicalIndex === 0) {
      track.scrollTo({ left: dots.length * track.clientWidth, behavior: "auto" });
    } else if (physicalIndex === dots.length + 1) {
      track.scrollTo({ left: track.clientWidth, behavior: "auto" });
    }
  };

  dots.forEach((dot, index) => dot.addEventListener("click", () => showSlide(index)));
  carousel?.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) => {
    button.addEventListener("click", () => moveBy(button.dataset.step === "1" ? 1 : -1));
  });

  let settleTimer: number | undefined;
  track?.addEventListener("scroll", () => {
    current = normalizeIndex(Math.round(track.scrollLeft / track.clientWidth) - 1);
    updateDots();
    window.clearTimeout(settleTimer);
    settleTimer = window.setTimeout(settleLoop, 120);
  }, { passive: true });
  track?.addEventListener("scrollend", settleLoop);
  track?.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
    event.preventDefault();
    moveBy(event.key === "ArrowRight" ? 1 : -1);
  });

  /**
   * Cycles the rotation with L and R when the user is not typing.
   * @param {KeyboardEvent} event - Browser keyboard event.
   * @returns {void}
   */
  const handleRotationShortcut = (event: KeyboardEvent) => {
    if (event.metaKey || event.ctrlKey || event.altKey || event.repeat) return;

    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      (target instanceof HTMLElement && target.isContentEditable)
    ) {
      return;
    }

    const key = event.key.toLowerCase();
    if (key !== "l" && key !== "r") return;

    moveBy(key === "r" ? 1 : -1);
  };

  window.addEventListener("keydown", handleRotationShortcut);
</script>

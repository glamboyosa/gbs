---
export interface Props {
  title: string
  description: string
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main class="doc">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --canvas: oklch(0.985 0.003 85);
    --ink: oklch(0.24 0.01 70);
    --ink-secondary: oklch(0.45 0.01 70);
    --line: color-mix(in oklch, var(--ink) 12%, transparent);
    --code-bg: color-mix(in oklch, var(--ink) 5%, transparent);
    --link: oklch(0.5 0.13 250);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --canvas: oklch(0.18 0.005 70);
      --ink: oklch(0.92 0.005 80);
      --ink-secondary: oklch(0.72 0.008 80);
      --link: oklch(0.78 0.11 250);
    }
  }

  body {
    margin: 0;
    background: var(--canvas);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 17px;
    line-height: 1.65;
  }

  .doc {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 1rem 6rem;
  }

  .doc h1,
  .doc h2,
  .doc h3 {
    font-weight: 600;
  }

  .doc h1 {
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }

  .doc h1 + p {
    color: var(--ink-secondary);
  }

  .doc h2 {
    font-size: 1.4rem;
    line-height: 1.3;
    margin: 3rem 0 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .doc h3 {
    font-size: 1.1rem;
    margin: 2rem 0 0.5rem;
  }

  .doc p,
  .doc ul,
  .doc ol,
  .doc pre,
  .doc table {
    margin: 0 0 1rem;
  }

  .doc ul,
  .doc ol {
    padding-left: 1.4rem;
  }

  .doc ul {
    list-style: disc;
  }

  .doc ol {
    list-style: decimal;
  }

  .doc li {
    margin-bottom: 0.4rem;
  }

  .doc strong {
    font-weight: 600;
  }

  .doc a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .doc code {
    font-size: 0.88em;
    padding: 0.1em 0.3em;
    border-radius: 4px;
    background: var(--code-bg);
  }

  .doc pre {
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .doc pre code {
    padding: 0;
    font-size: inherit;
    background: none;
  }

  .doc table {
    display: block;
    overflow-x: auto;
    font-size: 0.92rem;
  }

  .doc th,
  .doc td {
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .doc th {
    font-weight: 600;
  }
</style>

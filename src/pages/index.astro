---
import { NowPlaying } from "@/components/now-playing";
import SiteHeader from "@/components/SiteHeader.astro";
import RotationCarousel from "@/components/RotationCarousel.astro";
import ProjectFolder from "@/components/ProjectFolder.astro";
import StravaStats from "@/components/StravaStats.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";

const accessToken = Astro.cookies.get("spotify_access_token")?.value;
---

<Layout
  title="Osa | Product engineer"
  description="Osa is a product engineer who makes software and other things for the internet."
>
  <div class="page-shell neutral-shell">
    <SiteHeader current="home" />

    <main class="dashboard">
      <section class="panel intro-panel stagger-item">
        <div class="eyebrow"><span class="live-dot"></span> PRODUCT ENGINEER</div>
        <h1>I make software and <em>other things.</em></h1>
        <p>
          Hey, I’m Osa, also known as glamboyosa. I spend most of my time with Go,
          TypeScript, Next.js and Python. I like shipping useful things, learning
          in public and taking side projects too far.
        </p>
        <div class="intro-actions">
          <a class="button button-primary pressable" href="mailto:ogbemudiatimothy@gmail.com">Say hello <span>↗</span></a>
          <a class="button button-quiet pressable" href="https://github.com/glamboyosa" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>
        </div>
      </section>

      <StravaStats />

      <section class="panel listening-panel stagger-item">
        <div class="panel-label"><span>LISTENING</span><span class="signal" aria-hidden="true">🎵</span></div>
        <div class="listening-content">
          <p class="panel-heading">On repeat.</p>
          <p class="muted">Recently played on Spotify.</p>
          <NowPlaying client:load accessToken={accessToken} />
        </div>
      </section>

      <RotationCarousel />

      <section class="panel making-panel stagger-item">
        <div class="panel-label"><span>MAKING</span><span>05</span></div>
        <ProjectFolder />
        <div class="project-list">
          <a href="https://docket.glamboyosa.xyz" target="_blank" rel="noopener noreferrer">
            <span class="project-index">01</span>
            <span><strong>Docket</strong><small>A terminal document classifier built around Jev.</small></span>
            <i>↗</i>
          </a>
          <a href="https://conclave.click" target="_blank" rel="noopener noreferrer">
            <span class="project-index">02</span>
            <span><strong>Conclave</strong><small>AI decision memos with follow-up chat and saved revisions.</small></span>
            <i>↗</i>
          </a>
          <a href="https://pulseapp.click" target="_blank" rel="noopener noreferrer">
            <span class="project-index">03</span>
            <span><strong>Pulse</strong><small>Voice feedback, recorded and analyzed with AI.</small></span>
            <i>↗</i>
          </a>
          <a href="https://swig.glamboyosa.xyz" target="_blank" rel="noopener noreferrer">
            <span class="project-index">04</span>
            <span><strong>Swig</strong><small>A PostgreSQL job queue for Go.</small></span>
            <i>↗</i>
          </a>
          <a href="https://things.glamboyosa.xyz" target="_blank" rel="noopener noreferrer">
            <span class="project-index">05</span>
            <span><strong>Things</strong><small>Small projects and experiments.</small></span>
            <i>↗</i>
          </a>
        </div>
      </section>

      <section class="panel writing-panel stagger-item">
        <div class="panel-label"><span>WRITING</span><span>03</span></div>
        <div class="writing-glyph" aria-hidden="true">“</div>
        <div class="writing-links">
          <a href="https://blog.glamboyosa.xyz" target="_blank" rel="noopener noreferrer">
            <span><strong>Notes</strong><small>Code, design and whatever I am figuring out.</small></span>
            <i>↗</i>
          </a>
          <a href="https://www.freecodecamp.org/news/author/glamboyosa/" target="_blank" rel="noopener noreferrer">
            <span><strong>freeCodeCamp</strong><small>Tutorials and longer technical writing.</small></span>
            <i>↗</i>
          </a>
          <a href="https://blog.glamboyosa.xyz/blog/browser-review/" target="_blank" rel="noopener noreferrer">
            <span><strong>Latest on Notes</strong><small>Your coding agent should open the browser before it says it’s done.</small></span>
            <i>↗</i>
          </a>
        </div>
      </section>

      <a class="panel uses-panel stagger-item" href="/uses">
        <div class="panel-label"><span>WHAT I USE</span><span>↗</span></div>
        <div class="tool-cloud" aria-label="A few tools I use">
          <span>MacBook Air</span><span>Pixel 9</span><span>Momentum 4</span><span>Codex</span><span>Docker</span><span>PS5</span>
        </div>
        <p>Hardware, software and subscriptions. <strong>See the full setup ↗</strong></p>
      </a>
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Osa Ogbemudia</span>
      <a href="https://letterboxd.com/glamboyosa/" target="_blank" rel="noopener noreferrer">114 films and counting on Letterboxd ↗</a>
      <span>GMT+1 · probably online</span>
    </footer>
  </div>

</Layout>

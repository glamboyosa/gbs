---
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import Layout from "@/layouts/Layout.astro";

const groups = [
  {
    index: "01",
    title: "Hardware",
    description: "Computers, phones, headphones and consoles.",
    items: ["MacBook Air 13-inch · M3", "iPhone 17", "Google Pixel 9", "Sennheiser Momentum 4", "Nothing Ear 3", "PlayStation 5", "Xbox Series X"],
  },
  {
    index: "02",
    title: "Software",
    description: "Apps I use for work and everything else.",
    items: ["Codex", "Cursor", "Docker", "Docker Sandboxes", "CleanMyMac", "Edge", "HTTPie", "Linear", "Notion", "v0", "Raycast", "Alcove", "Proton", "OrbStack"],
  },
  {
    index: "03",
    title: "Music",
    description: "Subscriptions I still pay for.",
    items: ["Spotify", "Apple Music", "YouTube Premium", "YouTube"],
  },
];
---

<Layout title="Uses | Osa" description="The hardware, software and services Osa uses daily.">
  <div class="page-shell neutral-shell">
    <SiteHeader current="uses" />
    <main class="uses-page">
      <header class="uses-hero">
        <p class="eyebrow">SETUP · UPDATED 2026</p>
        <h1>My setup<span>.</span></h1>
        <p>Hardware, apps and services I use most days. This changes whenever my setup does.</p>
      </header>
      <div class="inventory-grid">
        {groups.map((group) => (
          <section class="inventory-card">
            <div class="panel-label"><span>{group.title.toUpperCase()}</span><span>{group.index}</span></div>
            <div>
              <h2>{group.title}</h2>
              <p>{group.description}</p>
            </div>
            <ul>
              {group.items.map((item) => (
                <li>
                  {item === "CleanMyMac" ? (
                    <a href="https://cleanmymac.com" target="_blank" rel="noopener noreferrer">CleanMyMac ↗</a>
                  ) : item}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </main>
    <footer class="site-footer"><span>Use what works.</span><a href="/">Back home ↗</a></footer>
  </div>
</Layout>
